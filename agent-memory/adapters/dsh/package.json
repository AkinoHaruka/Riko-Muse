{
  "name": "@agent-memory/dsh-adapter",
  "version": "0.5.1",
  "description": "Riko Memory 的 DSH Riko preset bundle 与宿主适配器",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkinoHaruka/Riko-Memory.git",
    "directory": "adapters/dsh"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mobile-api": {
      "types": "./dist/mobile-api.d.ts",
      "default": "./dist/mobile-api.js"
    }
  },
  "files": [
    "dist",
    "riko-preset.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\""
  },
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./riko-preset.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.2.0-rc.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
