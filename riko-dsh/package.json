{
  "name": "@riko/dsh",
  "version": "0.5.2",
  "description": "Riko Memory 的 DSH Riko preset bundle 与记忆宿主适配器",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkinoHaruka/Riko-Memory.git",
    "directory": "riko-dsh"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "riko-preset.patch.yml",
    "README.md",
    "soul.md",
    "alignment.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\""
  },
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./riko-preset.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "file:../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-llm": "file:../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-llm-pi-ai": "file:../../deepseek-harness/packages/llm/llm-pi-ai",
    "@deepseek-ai/dsh-session": "file:../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-tools": "file:../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-subagent": "file:../../deepseek-harness/packages/subagent/subagent",
    "@deepseek-ai/dsh-system-prompt": "file:../../deepseek-harness/packages/core/system-prompt",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
